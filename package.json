{
  "name": "adm-ltda",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts .unit.test.ts",
    "test:integration": "vitest run --config vitest.config.ts .integration.test.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "mutate": "stryker run",
    "prepare": "svelte-kit sync",
    "predev": "node scripts/sync-assets.mjs",
    "prebuild": "node scripts/sync-assets.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.0.0",
    "@stryker-mutator/vitest-runner": "^9.0.0",
    "@sveltejs/adapter-netlify": "^5.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.0.0",
    "autoprefixer": "^10.4.20",
    "fast-check": "^4.0.0",
    "postcss": "^8.4.49",
    "svelte": "^5.19.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@netlify/functions": "^4.0.0"
  }
}
