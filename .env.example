# Required by the production Netlify scheduled function and /api/cron.
CRON_SECRET=

# Turso (libSQL) database — products, prices, orders. See scripts/migrate.mjs.
# Use :memory: locally for tests; libsql://<db>.turso.io for dev/prod.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Mercado Pago Checkout Pro (https://www.mercadopago.com.br/developers)
# Access Token stays server-side — no public key is needed for the redirect flow.
MERCADO_PAGO_ACCESS_TOKEN=
# Optional sandbox comparison value. Set it to the SAME value as
# MERCADO_PAGO_ACCESS_TOKEN in test/sandbox environments so Checkout Pro
# redirects to the sandbox checkout (sandbox_init_point). Any other (or unset)
# value means production and the real init_point is used. Kept in env so the
# credential never lands in source.
MERCADO_PAGO_SANDBOX_ACCESS_TOKEN=
# Optional webhook signature secret — NOT part of the test credentials. It is
# generated in Suas integrações > Webhooks (Configure notifications > Save),
# per application. When set, notifications carrying an x-signature are
# validated; notifications delivered via the preference's notification_url are
# unsigned and are still accepted. Every notification is verified by
# re-fetching the payment from Mercado Pago before any status change.
MERCADO_PAGO_WEBHOOK_SECRET=
