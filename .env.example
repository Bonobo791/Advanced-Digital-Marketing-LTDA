# ── Mercado Pago checkout (see docs/mercado-pago-subscriptions.md) ──────
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_SANDBOX_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=  # verifies POST /api/webhooks/mercadopago signatures
# PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# ── Stripe checkout, en-US USD (see docs/stripe-checkout.md) ────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=  # verifies POST /api/webhooks/stripe signatures

# ── Opt-in contact form (see docs/contact-form.md) ───────────────────────
# MailJet Send API v3.1 credentials (Basic auth pair).
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# From address; must be a validated sender in the MailJet account.
# Falls back to the site contact address (with a loud server log) if unset.
# MAILJET_SENDER_EMAIL=
# MAILJET_SENDER_NAME=Advanced Digital Marketing
# HMAC secret for the verification tokens — use `openssl rand -hex 32`.
# Without it the form endpoint refuses with 503 server_misconfigured.
# CONTACT_FORM_TOKEN_SECRET=
# Inbox that receives verified contacts (defaults to the site contact address).
# CONTACT_FORM_OWNER_EMAIL=
# true = MailJet validates payloads without delivering (local testing ONLY —
# never in production: the server refuses to send when NODE_ENV=production).
# MAILJET_SANDBOX_MODE=true

# ── Shared ───────────────────────────────────────────────────────────────
# Public HTTPS origin used for back-links (Mercado Pago back_url + the
# contact verification link). Falls back to the canonical domain loudly.
# PUBLIC_SITE_URL=https://advanceddigitalmarketingltda.com

# ── Reverse-proxy client IP (Coolify / adapter-node, REQUIRED) ───────────
# adapter-node's getClientAddress() only reads the forwarded client address
# when these are set; without them every visitor shares the proxy address and
# the per-IP rate limiter throttles the whole site together.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# ── Bunny CDN cache purge (CI-only; see docs/bunny-cdn-purge.md) ─────────
# Used by scripts/wait-for-coolify-deploy.mjs and scripts/purge-bunny-cache.mjs
# in the GitHub Actions deploy workflow. NEVER set these in the application
# runtime (Coolify environment variables) — the keys stay in GitHub Actions
# secrets only; the ids/urls are non-secret repository variables.
# BUNNY_API_KEY=
# BUNNY_PULL_ZONE_ID=
# COOLIFY_API_TOKEN=
# COOLIFY_API_URL=
# COOLIFY_APPLICATION_UUID=
# PURGE_REQUIRE_CREDS=1   # unset for local dev no-op runs of the purge script
